{
  "servers": {
    "cgu": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "${workspaceFolder}",
        "run",
        "cgu-server"
      ],
      "env": {
        "CGU_PROVIDER": "passthrough",
        "CGU_EMBEDDING": "ngram"
      },
      "envFile": "${workspaceFolder}/.env"
    }
  },
  "inputs": []
}
